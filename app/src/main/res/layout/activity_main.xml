<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="16dp">

                <!-- SECCIÓN DE BIENVENIDA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/welcomeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface_variant"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/nameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alex"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <!-- CARD FRASE MOTIVADORA -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_stroke"
                    app:cardBackgroundColor="@color/surface_container_low">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❝"
                            android:textSize="32sp"
                            android:textColor="@color/primary"
                            android:alpha="0.6"
                            android:fontFamily="sans-serif"/>

                        <TextView
                            android:id="@+id/motivationalPhraseTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="The only place where success comes before work is in the dictionary."
                            android:textStyle="italic"
                            android:textSize="16sp"
                            android:textColor="@color/on_surface"
                            android:lineSpacingExtra="6dp"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- SECCIÓN ROUTINES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="YOUR ROUTINES"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textAllCaps="true"
                        android:textColor="@color/on_surface"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/routinesCountTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 Active"
                        android:textSize="14sp"
                        android:textColor="@color/primary"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- RECYCLERVIEW - SCROLL PROPIO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/routineRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_routine" />

    </LinearLayout>

    <!-- BOTON NUEVA RUTINA -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addRoutineFAB"
        style="?attr/floatingActionButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:maxImageSize="32dp"
        android:foreground="?attr/selectableItemBackground"
        android:backgroundTint="?attr/colorPrimary"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/on_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>