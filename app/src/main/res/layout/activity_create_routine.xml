<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.CreateRoutineActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- Título NEW PROTOCOL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CREATE ROUTINE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp"
            android:paddingTop="16dp"/>

        <!-- Subtítulo Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Basic Setup"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="24dp" />

        <!-- Campo: Routine Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Routine Name"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/outline"
            app:hintTextColor="@color/on_surface_variant"
            android:layout_marginBottom="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/routineNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="@color/on_surface"
                android:hint="e.g. 5x5 Powerlift Phase 1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Sección: Training Category (Chips) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Training Category"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.1" />

        <!-- Subtítulo con hint visual de scroll -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select one category"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:fontFamily="sans-serif" />

            <!-- Indicador visual -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:alpha="0.7">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="←  swipe  →"
                    android:textSize="10sp"
                    android:textColor="@color/primary"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_swipe"
                    android:tint="@color/primary"
                    android:alpha="0.6" />

            </LinearLayout>

        </LinearLayout>

        <!-- RecyclerView horizontal para categorías -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoriesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="20dp"
            android:clipToPadding="false"
            android:paddingEnd="20dp" />

        <!-- Sección: Weekly Frequency -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Weekly Frequency"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select training days"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="16dp" />

        <!-- Chips de días -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/daysChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:chipSpacing="8dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMon"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="M"
                android:checkable="true"
                app:chipIconEnabled="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTue"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="W"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThu"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="T"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFri"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="F"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSat"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSun"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Resumen de días -->
        <TextView
            android:id="@+id/selectedDaysSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 days selected"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Espacio flexible para empujar botones abajo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Botón SAVE -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveRoutine"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="SAVE ROUTINE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textColor="@color/on_primary"
            app:cornerRadius="12dp"
            app:backgroundTint="?attr/colorPrimary"
            android:letterSpacing="0.1"
            android:layout_marginTop="16dp" />

        <!-- Botón Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CANCEL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_variant"
            app:cornerRadius="12dp"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>