<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".activities.ExerciseSelectorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header con botón back -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:padding="4dp"
                app:tint="@color/on_surface" />

            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Add Exercise"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <!-- Espacio para balancear el back -->
            <View android:layout_width="32dp" android:layout_height="32dp" />

        </LinearLayout>

        <!-- Hint de categoría -->
        <TextView
            android:id="@+id/categoryHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Showing exercises for: STRENGTH"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp" />

        <!-- Sección EXERCISES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="EXERCISES"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textAllCaps="true"
                android:textColor="@color/on_surface_variant"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/exercisesCountTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 exercises"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/exercisesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="80dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_exercise_selector" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>